<Window x:Class="Blabla.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blabla"
        Width="780" Height="580"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#F6F6F7"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8E"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0">

            <!-- ═══════════ Geschiedenis (US4) ═══════════ -->
            <TabItem Header="Geschiedenis">
                <Grid Margin="8">
                    <TextBlock x:Name="HistoryEmptyText"
                               Text="Nog geen transcripties. Druk op de opname-sneltoets om te dicteren."
                               Foreground="#8A8A8E" Margin="6" Visibility="Collapsed"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryList"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══════════ Presets (US3) ═══════════ -->
            <TabItem Header="Presets">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="NewPresetButton" Content="Nieuw" Click="NewPresetButton_Click"/>
                            <Button x:Name="DeletePresetButton" Content="Verwijderen" Margin="8,0,0,0"
                                    Click="DeletePresetButton_Click"/>
                        </StackPanel>
                        <ListBox x:Name="PresetList" DisplayMemberPath="Name"
                                 SelectionChanged="PresetList_SelectionChanged"/>
                    </DockPanel>

                    <StackPanel Grid.Column="1" x:Name="PresetEditor">
                        <TextBlock Text="Naam" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                        <TextBox x:Name="PresetNameBox"/>

                        <CheckBox x:Name="PresetActiveBox" Content="Actieve preset" Margin="0,10,0,10"/>

                        <TabControl>
                            <TabItem Header="Spraak naar tekst">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Contextprompt voor OpenAI" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="PresetPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="110" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Beschrijf het onderwerp en noem eigennamen/vaktermen voor betere herkenning."/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Taal" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="PresetLanguageBox"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="ISO-code zoals nl of en; leeg = automatisch."/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="PresetTemperatureBox"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="0 t/m 1; leeg = standaard."/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="PresetModelBox"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Bijv. gpt-4o-transcribe, gpt-transcribe (nieuwer), gpt-4o-mini-transcribe of whisper-1."/>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Nabewerking (LLM)">
                                <StackPanel Margin="8">
                                    <CheckBox x:Name="PresetLlmEnabledBox"
                                              Content="Tekst laten nabewerken door een taalmodel"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="De transcriptie wordt als bericht naar dit model gestuurd; het antwoord is wat er wordt geplakt."/>

                                    <StackPanel x:Name="LlmOptionsPanel"
                                                IsEnabled="{Binding IsChecked, ElementName=PresetLlmEnabledBox}">
                                        <TextBlock Text="Systeemprompt" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="PresetLlmPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                                 Height="110" VerticalScrollBarVisibility="Auto"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Bijv.: 'Dit is voor e-mails. Maak er nette e-mailtekst van, corrigeer spelfouten en maak de zinnen logisch. Geef alleen de herschreven tekst terug.'"/>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="PresetLlmModelBox"/>
                                                <TextBlock Style="{StaticResource Hint}" Text="Bijv. gpt-5-mini of gpt-4.1-mini."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="PresetLlmTemperatureBox"/>
                                                <TextBlock Style="{StaticResource Hint}" Text="Leeg = standaard (sommige modellen accepteren alleen standaard)."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Vervangingen">
                                <StackPanel Margin="8">
                                    <TextBlock Text="Zoeken en vervangen" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="PresetReplacementsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                             Height="160" VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Text="Eén vervanging per regel, bijv. cloud=Claude. Hoofdletterongevoelig en alleen hele woorden. Wordt toegepast direct na de transcriptie (vóór de LLM-nabewerking)."/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ═══════════ Instellingen (US2) ═══════════ -->
            <TabItem Header="Instellingen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" MaxWidth="560" HorizontalAlignment="Left">

                        <GroupBox Header="OpenAI">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="API-key" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ApiKeyStatus" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Foreground="#8A8A8E"/>
                                </DockPanel>
                                <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,0"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Wordt versleuteld opgeslagen (alleen leesbaar door jouw Windows-account). Laat leeg om de huidige key te behouden."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Sneltoetsen">
                            <StackPanel>
                                <TextBlock Text="Opnemen / stoppen" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                <TextBox x:Name="RecordHotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         PreviewKeyDown="RecordHotkeyBox_PreviewKeyDown" Cursor="Hand"/>
                                <TextBlock Text="Laatste transcriptie plakken" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PasteHotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                         PreviewKeyDown="PasteHotkeyBox_PreviewKeyDown" Cursor="Hand"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Klik in een veld en druk de gewenste toetscombinatie (bijv. Ctrl+Alt+Spatie)."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Systeem">
                            <CheckBox x:Name="AutoStartBox" Content="Automatisch starten met Windows"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="Opslaan" DockPanel.Dock="Right"
                    FontWeight="SemiBold" Click="SaveButton_Click"/>
            <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" Foreground="#5A8A5A"/>
        </DockPanel>
    </Grid>
</Window>

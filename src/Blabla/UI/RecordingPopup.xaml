<Window x:Class="Blabla.UI.RecordingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="420">
    <Border CornerRadius="14" Background="#F21E1E22" Padding="16,11">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="StateDot" Width="13" Height="13" Fill="#EB5046" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="#F0F0F0" FontSize="14" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="TimerText" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold"
                       Margin="8,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="PresetText" Foreground="#9A9AA0" FontSize="13"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       ToolTip="Wissel preset met Ctrl+↑ / Ctrl+↓"/>
            <Button x:Name="CancelButton" Content="✕" Margin="12,0,0,0" Padding="6,1"
                    VerticalAlignment="Center" Click="CancelButton_Click"
                    Background="Transparent" Foreground="#B0B0B4" BorderThickness="0"
                    FontSize="13" Cursor="Hand" Focusable="False"
                    ToolTip="Annuleren (Esc)"/>
        </StackPanel>
    </Border>
</Window>
